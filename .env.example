# DigitallyDefined Dashboard - Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local

# Supabase project URL (no trailing slash)
VITE_SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co

# Supabase anonymous key (safe for frontend - from Supabase dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=

# Custom API key for Hermes edge function (must match HERMES_API_KEY in Supabase secrets)
VITE_DASHBOARD_API_KEY=

# AI model to use in dashboard assistant (optional - defaults to openai/gpt-4o-mini)
VITE_DASHBOARD_ASSISTANT_MODEL=openai/gpt-4o-mini
